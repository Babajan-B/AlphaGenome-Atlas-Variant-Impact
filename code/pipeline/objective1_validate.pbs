#!/bin/bash
#PBS -N AGVUS_refcheck
#PBS -q fat
#PBS -l select=1:ncpus=8:mem=120gb
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
ROOT=/path/to/project_root/AG-VUS
mkdir -p "$ROOT/logs" "$ROOT/reports"
exec >"$ROOT/logs/objective1_validate.log" 2>&1
echo "started=$(date --iso-8601=seconds) host=$(hostname)"
"$ROOT/environment/alphagenome-py310/bin/python" /path/to/AG-VUS/scripts/06_validate_reference_and_freeze.py --root "$ROOT"
echo "completed=$(date --iso-8601=seconds)"
