#!/bin/bash
#PBS -N AGVUS_parse
#PBS -q thin
#PBS -l select=1:ncpus=4:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
ROOT=/path/to/project_root/AG-VUS
SHARD_INDEX=${SHARD_INDEX:?}
SHARD_COUNT=${SHARD_COUNT:-8}
"$ROOT/environment/alphagenome-py310/bin/python" /path/to/AG-VUS/scripts/04_parse_clinvar_releases.py \
  --root "$ROOT" --shard-index "$SHARD_INDEX" --shard-count "$SHARD_COUNT"
